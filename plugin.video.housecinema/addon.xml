<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.housecinema" name="HouseCinema" version="1.0.0" provider-name="HouseCinema Team">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="sk">Filmy z Webshare cez CZDB databázu</summary>
        <description lang="sk">Prepojenie prémia Webshare s indexom CZDB. Podporuje radenie podľa žánrov, abecedy a vyhľadávanie streamov.</description>
    </extension>
</addon>
